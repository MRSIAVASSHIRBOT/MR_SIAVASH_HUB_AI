MRH_ENVIRONMENT=development
MRH_HOST=127.0.0.1
MRH_PORT=8000
MRH_DATABASE_PATH=./data/mrhub.sqlite3
MRH_LOG_LEVEL=INFO
MRH_SESSION_TTL_HOURS=12
# Durable Agent runs require a unique 32-byte key; the API and worker read it from .env.
# Never commit the real value; .env is git-ignored.
# Example: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# MRH_WORKFLOW_PAYLOAD_KEY=<generated-url-safe-base64-key>

# Optional local Ollama vision. Disabled by default and restricted to loopback.
# Vision uses the local inference base URL but has its own independent enable switch.
# Use an already-installed vision-capable model (for example, a LLaVA-family model).
# No model is downloaded automatically and no remote provider fallback is attempted.
# MRH_LOCAL_INFERENCE_BASE_URL=http://127.0.0.1:11434
# MRH_LOCAL_VISION_ENABLED=false
# MRH_LOCAL_VISION_MODEL=<installed-vision-model>
# MRH_LOCAL_VISION_TIMEOUT_SECONDS=120

# Optional remote inference. Disabled by default; remote requests send input text to OpenRouter.
# A model marked free by the provider is not a guarantee of permanent availability or zero cost.
# Enable only after reviewing provider privacy, model terms, and current pricing.
# MRH_REMOTE_INFERENCE_ENABLED=false
# MRH_REMOTE_INFERENCE_API_KEY=<openrouter-api-key>
# MRH_REMOTE_INFERENCE_MODEL=<explicit-model-id>
# MRH_REMOTE_INFERENCE_BASE_URL=https://openrouter.ai/api/v1
# MRH_REMOTE_INFERENCE_TIMEOUT_SECONDS=30

# Optional Moonshot Kimi K3.1 Pro inference. Disabled by default.
# Requests send submitted text to Moonshot's official API; no automatic fallback is used.
# Keep the API key in the ignored .env file or deployment secret manager, never source control.
# MRH_KIMI_INFERENCE_ENABLED=false
# MRH_KIMI_API_KEY=<moonshot-api-key>
# MRH_KIMI_MODEL=kimi-k3.1-pro
# MRH_KIMI_REASONING_EFFORT=high
# MRH_KIMI_TIMEOUT_SECONDS=60

# Optional Telegram publishing. Keep real credentials in the deployment environment only.
# Set both values to enable Telegram delivery during explicit WorkerEngine.run_once() cycles.
# MRH_TELEGRAM_BOT_TOKEN=<telegram-bot-token>
# MRH_TELEGRAM_CHAT_ID=@your_channel_or_chat_id

# Optional Instagram Graph API publishing. Requires an authorized professional account,
# current Meta app permissions, and explicit operator acceptance testing.
# Keep real credentials outside source control and rotate them if exposed.
# MRH_INSTAGRAM_ACCESS_TOKEN=<instagram-access-token>
# MRH_INSTAGRAM_USER_ID=<instagram-professional-account-id>
# MRH_INSTAGRAM_GRAPH_API_VERSION=v24.0

# Optional public image delivery for Instagram Graph API. Must be reachable by Meta over HTTPS.
# Set this only after deploying and externally verifying the media origin and edge rate limits.
# MRH_PUBLIC_MEDIA_BASE_URL=https://media.example.org
# Generate a unique random secret of at least 32 characters; never commit the real value.
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
# MRH_PUBLIC_MEDIA_SIGNING_KEY=<unique-random-signing-key>

# Optional local assistant gateway bridge. Disabled by default and restricted to loopback IPs.
# Enable only after manually installing and configuring a compatible local gateway.
# MRH_ASSISTANT_GATEWAY_ENABLED=false
# MRH_ASSISTANT_GATEWAY_BASE_URL=http://127.0.0.1:<configured-port>
# MRH_ASSISTANT_GATEWAY_HEALTH_PATH=/health
# MRH_ASSISTANT_GATEWAY_TIMEOUT_SECONDS=2
# MRH_ASSISTANT_GATEWAY_MAX_RESPONSE_BYTES=8192

# Optional isolated Cloudflare Workers gateway. Disabled by default; the provider token stays in the Worker.
# The Hub stores only a separate gateway bearer token. Enable after deploying and verifying
# the dedicated read-only gateway; then explicitly grant cloudflare.read to the owner.
# MRH_CLOUDFLARE_GATEWAY_ENABLED=false
# MRH_CLOUDFLARE_GATEWAY_BASE_URL=https://<your-gateway>.workers.dev
# MRH_CLOUDFLARE_GATEWAY_TOKEN=<separate-random-gateway-token>
# MRH_CLOUDFLARE_GATEWAY_TIMEOUT_SECONDS=8
# MRH_CLOUDFLARE_GATEWAY_MAX_RESPONSE_BYTES=1048576

# Optional local code engine. Disabled by default; health checks are loopback-only.
# MRH_CODE_ENGINE_ENABLED=false
# MRH_CODE_ENGINE_BASE_URL=http://127.0.0.1:<configured-port>
# MRH_CODE_ENGINE_HEALTH_PATH=/health
# MRH_CODE_ENGINE_TIMEOUT_SECONDS=2
# MRH_CODE_ENGINE_MAX_RESPONSE_BYTES=8192

# Optional MCP interoperability bridge. Installs with: python -m pip install -e ".[mcp]"
# Runs as a separate process and remains disabled unless explicitly enabled.
# It binds to loopback only; do not expose this port publicly.
MRH_MCP_ENABLED=false
MRH_MCP_HOST=127.0.0.1
MRH_MCP_PORT=8765
